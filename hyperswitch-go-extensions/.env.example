# Environment variables for Hyperswitch Go Extensions

# Server Configuration
PORT=8081
ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hyperswitch
DB_MAX_CONNECTIONS=25
DB_IDLE_CONNECTIONS=5

# Redis (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Forex / Currency
FX_API_KEY=your_openexchangerates_api_key
FX_CACHE_TTL=3600
FX_FEE_PERCENTAGE=1.5

# Subscriptions
DUNNING_MAX_RETRIES=3
DUNNING_RETRY_DAYS=1,3,7,14
DUNNING_GRACE_PERIOD=5
DUNNING_CANCEL_AFTER=30

# Marketplace
PLATFORM_FEE_PERCENTAGE=10.0
ESCROW_DEFAULT_DAYS=7
PAYOUT_SCHEDULE=daily

# Authentication
API_KEY_SECRET=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Webhooks
WEBHOOK_SECRET=your_webhook_secret

# External Services
STRIPE_API_KEY=sk_test_...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# Feature Flags
ENABLE_SUBSCRIPTIONS=true
ENABLE_MARKETPLACE=true
ENABLE_WALLETS=true
ENABLE_FOREX=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200
